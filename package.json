{
  "name": "evok-node",
  "version": "0.0.0",
  "private": true,
  "description": "A Node.js/TypeScript drop-in replacement for Unipi Technology's EVOK 3.x API",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "~24.13.3",
    "@vitest/coverage-v8": "~4.1.10",
    "typescript": "~6.0.3",
    "vitest": "~4.1.10"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
